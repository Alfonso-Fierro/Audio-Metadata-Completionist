# Audio Metadata Completionist Configuration

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/audio_metadata.log

# AcousticID Configuration (for audio fingerprinting)
# Get your API key from: https://acoustid.org/api-key
ACOUSTID_API_KEY=your_acoustid_api_key_here

# MusicBrainz Configuration
# Email is required for MusicBrainz API (rate limiting)
MUSICBRAINZ_CONTACT_EMAIL=your_email@example.com
MUSICBRAINZ_APP_NAME=AudioMetadataCompletionist
MUSICBRAINZ_APP_VERSION=1.0.0

# HTTP Configuration
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY=1

# Cache Configuration
CACHE_ENABLED=true
CACHE_DIR=.cache
CACHE_TTL=86400

# Artwork Configuration
ARTWORK_MIN_SIZE=500
ARTWORK_MAX_SIZE=2000
ARTWORK_FORMAT=jpg

# Processing Configuration
MAX_WORKERS=4
BATCH_SIZE=10
